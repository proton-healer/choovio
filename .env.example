# Choovio configuration. Copy to .env and fill in what you have.
# Secrets in this file stay on the server; they are never sent to the browser or put in ACP deliverables.

# --- Live research -----------------------------------------------------------
# Search provider: auto | tavily | serper | brave | openai | none
# "auto" uses the first key that is set, in this order: brave, tavily, serper, openai.
CHOOVIO_SEARCH_PROVIDER=auto
# Tavily: free 1,000 searches/month, no card. https://app.tavily.com
TAVILY_API_KEY=
# Serper (Google results): 2,500 free searches, no card. https://serper.dev
SERPER_API_KEY=
# Brave Search: requires a card on file. https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# OpenAI API key: better request understanding and page extraction.
# With no other search key set, it also powers search (OpenAI web search tool, billed per call).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
CHOOVIO_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max for gpt-6-luna (older gpt-5 models also accept minimal)
CHOOVIO_LLM_EFFORT=low
CHOOVIO_DISABLE_LLM=false

# --- Web app -----------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Demo mode serves clearly labeled fictional products (no network). Set false to hide it.
CHOOVIO_ALLOW_DEMO=true

# --- Affiliate links (optional, always disclosed, never affect ranking) --------
# Comma-separated host=param=value, e.g. amazon.com=tag=yourtag-20
CHOOVIO_AFFILIATE_TAGS=

# --- ACP provider ------------------------------------------------------------
# The ACP CLI holds auth, wallet and signer keys in your OS keychain (acp configure / acp agent add-signer).
# Choovio never needs a private key in this file.
CHOOVIO_PRICE_USDC=0.5
CHOOVIO_SLA_MINUTES=5
# Only needed if acp-cli is not installed globally (path to @virtuals-protocol/acp-cli/dist/bin/acp.js):
# ACP_CLI_PATH=
# CHOOVIO_EVENTS_FILE=.acp/events.jsonl
# CHOOVIO_STATE_FILE=.acp/jobs.json
# CHOOVIO_RESEARCH_DEADLINE_MS=240000
# Per-request search API timeout (retried once, then the next configured provider is tried).
# CHOOVIO_SEARCH_TIMEOUT_MS=20000

# --- Pay-per-request API (x402) — Nevermined Catalog and other agent buyers ---
# Enables POST /api/compare at CHOOVIO_PRICE_USDC per successful comparison. Leave empty to keep it off.
# The wallet that receives payments. Choovio never needs its private key.
CHOOVIO_X402_PAY_TO=
# base-sepolia = testnet (free test USDC, try it first). base = real USDC on Base.
CHOOVIO_X402_NETWORK=base-sepolia
# Public HTTPS address once deployed, e.g. https://choovio.up.railway.app
CHOOVIO_PUBLIC_URL=
# Optional overrides (defaults: x402.org facilitator on testnet, PayAI on base — neither needs an account):
# CHOOVIO_X402_PRICE_USD=0.5
# CHOOVIO_X402_FACILITATOR_URL=
# CHOOVIO_X402_FACILITATOR_TOKEN=
# CHOOVIO_X402_DEADLINE_MS=150000
# CHOOVIO_X402_MAX_CONCURRENT=4

# --- Nevermined plan credits on the same endpoint (buyers from the plan's checkout link) ---
# Needs the paid API above. Leave NVM_API_KEY empty to keep it off.
# API key: Nevermined app → Account → API keys (from the organization that owns the plan).
NVM_API_KEY=
# Copy both from the agent page (Linked plan(s) → Plan ID, and Agent ID).
NVM_PLAN_ID=
NVM_AGENT_ID=
# live (Base mainnet) or sandbox (Base Sepolia). Must match where the plan was created.
NVM_ENVIRONMENT=live
# Must match the plan's "Credits per request".
# NVM_CREDITS_PER_REQUEST=1
